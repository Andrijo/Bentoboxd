# Clave de la API de TMDB (https://www.themoviedb.org/settings/api)
# IMPORTANTE: el prefijo VITE_ es obligatorio; sin él Vite no la expone al cliente.
VITE_TMDB_API_KEY=

# Proxy del RSS de Letterboxd en producción.
# En Vercel puedes dejarlo vacío: el build usa /api/rss por defecto.
# En desarrollo siempre se usa /rss-proxy (vite.config.js).
# Ejemplos:
#   VITE_RSS_PROXY_URL=/api/rss
#   VITE_RSS_PROXY_URL=https://tu-worker.workers.dev/rss/{user}
VITE_RSS_PROXY_URL=
