# Clave de la API de TMDB (https://www.themoviedb.org/settings/api)
# Solo la leen los proxies (vite.config.js en dev, api/tmdb.js en producción):
# nunca se incluye en el bundle del navegador.
# No uses VITE_TMDB_API_KEY: el prefijo VITE_ la expondría al cliente.
TMDB_API_KEY=

# Proxy del RSS de Letterboxd en producción.
# En Vercel puedes dejarlo vacío: el build usa /api/rss por defecto.
# En desarrollo siempre se usa /rss-proxy (vite.config.js).
# Ejemplos:
#   VITE_RSS_PROXY_URL=/api/rss
#   VITE_RSS_PROXY_URL=https://tu-worker.workers.dev/rss/{user}
VITE_RSS_PROXY_URL=

# Proxy de TMDB. Por defecto /api/tmdb (dev y Vercel).
# Solo cámbialo si alojas el proxy en otro dominio.
VITE_TMDB_PROXY_URL=
